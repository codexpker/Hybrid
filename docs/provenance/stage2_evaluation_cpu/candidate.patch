+                    per_fault.append(dict(**base,metric=metric,fault_id=f,mean=float(entity[fi].mean())))
+                for ri,r in enumerate(runs):per_run.append(dict(**base,metric=metric,run_id=r,mean=float(entity[:,ri].mean())))
